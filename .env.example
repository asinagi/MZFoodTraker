# Copy to .env only when it does not already exist. Never commit real credentials.
# Core runtime (Python standard library; no API key required for RSS).
PORT=8000
DATABASE_PATH=data/trends.sqlite3
COLLECT_INTERVAL_SECONDS=1800
RSS_TIMEOUT_SECONDS=20

# Instagram Graph API (Facebook Login). Replace synthetic account IDs locally.
INSTAGRAM_GRAPH_API_VERSION=v26.0
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=00000000000000000
FACEBOOK_PAGE_ID=0000000000000000
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_COLLECTION_ENABLED=false
INSTAGRAM_COLLECTION_INTERVAL_MINUTES=60
# Optional safeguards
INSTAGRAM_TIMEOUT_SECONDS=20
INSTAGRAM_MAX_PAGES=20
INSTAGRAM_SEARCH_SOFT_LIMIT=28
INSTAGRAM_CAPTION_RETENTION_DAYS=30

# NAVER API HUB - Data Lab Search Trend
NAVER_DATALAB_CLIENT_ID=
NAVER_DATALAB_CLIENT_SECRET=
NAVER_DATALAB_ENABLED=false
NAVER_DATALAB_INTERVAL_SECONDS=86400
NAVER_DATALAB_DAILY_LIMIT=100
NAVER_DATALAB_TIMEOUT_SECONDS=20

# YouTube Data API v3 (API key only; no OAuth or paid services)
YOUTUBE_API_KEY=
# Existing installations may use YOUTUBE_DATA_API_V3_KEY as a fallback.
YOUTUBE_DATA_API_V3_KEY=
YOUTUBE_COLLECTION_ENABLED=false
YOUTUBE_INTERVAL_SECONDS=21600
YOUTUBE_DISCOVERY_QUERIES=["신상 디저트", "유행 음식", "요즘 먹방", "편의점 신상", "신상 간식", "카페 신메뉴"]
YOUTUBE_QUERIES_PER_RUN=8
YOUTUBE_MAX_PAGES=1
YOUTUBE_DAILY_SEARCH_LIMIT=40
YOUTUBE_DAILY_VIDEO_LIMIT=1000
YOUTUBE_TIMEOUT_SECONDS=20
